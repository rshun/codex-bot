# Copy to .env and replace placeholders locally. Never commit real credentials.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_USER_ID=your_telegram_user_id_here
CODEX_BIN=/home/codex/.local/bin/codex
WORKDIR=/home/codex

# Optional: blank means use the Codex CLI default configuration.
CODEX_MODEL=
# Optional comma-separated model IDs. Blank allows any syntactically valid ID.
# This list is a local restriction, not a query of models available to your account.
CODEX_MODELS=
CODEX_TIMEOUT_MS=120000

# Defaults to .bot-state/sessions.json beside index.js.
# If changed, keep the file outside tracked source paths and add an ignore rule.
# SESSION_FILE=/path/to/private/bot-state/sessions.json
# Normally inferred from the service account's home directory.
# CODEX_HOME=/home/codex/.codex
