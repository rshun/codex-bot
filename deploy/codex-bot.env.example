TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=
DATA_DIR=/var/lib/codex-bot
DEFAULT_MODEL=gpt-5.4
CODEX_MODELS=
CODEX_BIN=codex
CODEX_HOME=
CODEX_AUTH_PATH=
CODEX_MAX_TURNS=50
CODEX_TIMEOUT=10m
WEB_SEARCH=true
LINK_PREFETCH=true
ALLOW_SHELL=false
SHOW_PROGRESS=false
BOT_ENV_FILE=/etc/codex-bot.env
TIMEZONE=
TASK_LIMIT=20
TASK_MIN_INTERVAL=60m
SCRIPT_DIRS=
SCRIPT_TIMEOUT=30m
