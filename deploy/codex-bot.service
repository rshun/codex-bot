[Unit]
Description=Codex bot for Telegram and Discord
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The account that has already run `codex login`.
User=codex
EnvironmentFile=/etc/codex-bot.env
# Tip: install the binary in a directory owned by `User=codex` (e.g. /home/codex/bin/codex-bot)
# so in-chat `/upgrade` and `AUTO_UPGRADE=true` can atomically self-upgrade without root/sudo.
ExecStart=/usr/local/bin/codex-bot
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
