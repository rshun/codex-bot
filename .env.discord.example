# Copy to .env.discord; fill credentials locally and keep the actual file private.
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_ALLOWED_USER_ID=your_discord_user_id_here
# Empty means all guild channels are disabled; list exact channel/thread IDs.
DISCORD_CHANNEL_IDS=
DISCORD_ALLOW_DMS=true
# Application ID is needed only when applying slash-command registration.
DISCORD_APPLICATION_ID=
# Optional: scope slash commands to one guild for initial acceptance testing.
# Blank registers global commands, which can also be used in DMs.
DISCORD_COMMAND_GUILD_ID=
CODEX_BIN=/home/codex/.local/bin/codex
WORKDIR=/home/codex/discord-workdir
CODEX_HOME=/home/codex/.codex
CODEX_MODEL=
CODEX_MODELS=
CODEX_TIMEOUT_MS=120000
SESSION_FILE=/home/codex/codex-tg-bot/.bot-state/discord-sessions.json
